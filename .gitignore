# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# ─── Variables de entorno (NUNCA subir a Git) ────────────────
.env
.env.*
!.env.example
*.env

# ─── Credenciales Firebase / Google ─────────────────────────
google-services.json
GoogleService-Info.plist
google-credentials.json

# ─── Dependencias ───────────────────────────────────────────
node_modules/

# ─── Expo ───────────────────────────────────────────────────
.expo/
dist/
web-build/
expo-env.d.ts

# ─── Builds nativos generados ────────────────────────────────
/ios
/android

# ─── Certificados y claves de firma ─────────────────────────
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.keystore

# ─── Metro bundler ──────────────────────────────────────────
.metro-health-check*

# ─── Debug / logs ───────────────────────────────────────────
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# ─── macOS ──────────────────────────────────────────────────
.DS_Store
*.pem

# ─── TypeScript ─────────────────────────────────────────────
*.tsbuildinfo

# ─── EAS / Expo secrets ─────────────────────────────────────
.easignore
